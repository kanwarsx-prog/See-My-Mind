# See My Mind Environment Configuration
APP_ENV=development
PROJECT_NAME="See My Mind & NOYA AI"
API_V1_STR=/api/v1
SECRET_KEY=replace_with_a_secure_random_key_in_production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (Supabase or Local Docker)
# Local Docker: postgresql+psycopg://seemymind:seemymind_dev_password@localhost:5432/seemymind_db
# Supabase: postgresql+psycopg://postgres.[project]:[password]@aws-0-eu-west-2.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=postgresql+psycopg://seemymind:seemymind_dev_password@localhost:5432/seemymind_db

# OpenAI / Azure OpenAI Configuration (For NOYA AI Engine)
OPENAI_API_KEY=your_openai_or_azure_api_key_here
OPENAI_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536

# CORS Origins (Comma-separated for web & mobile clients)
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:8081","http://localhost:19006"]
